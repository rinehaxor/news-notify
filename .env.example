# ── Telegram ─────────────────────────────────────────────
# Token bot dari @BotFather (Wajib)
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID Chat Admin untuk mengelola feed & AI rewrite (Opsional tapi direkomendasikan)
ADMIN_CHAT_ID=123456789

# ── RSS Feeds ─────────────────────────────────────────────
# Pisahkan dengan koma (,) untuk beberapa sumber
RSS_FEEDS=https://stockwatch.id/feed/,https://www.idxchannel.com/rss

# ── Pengaturan ────────────────────────────────────────────
# Interval pengecekan dalam MENIT (default: 5)
INTERVAL_MINUTES=5

# Timezone untuk format waktu artikel (default: Asia/Jakarta)
TIMEZONE=Asia/Jakarta

# ── Kimi AI (Rewrite Artikel) ──────────────────────────────
# API key dari Moonshot AI (https://platform.moonshot.cn)
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxx

# Model Kimi yang dipakai (default: kimi-k2-turbo-preview)
KIMI_MODEL=kimi-k2-turbo-preview
